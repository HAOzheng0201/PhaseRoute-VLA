# Copy to .env.personal only if you need local overrides.
# .env.personal is ignored by Git.

# Executable and local caches
export PYTHON_BIN=python
export HF_HOME="$PWD/.cache/huggingface"
export LIBERO_CONFIG_PATH="$PWD/.cache/libero"

# PhaseRoute-VLA configuration
export DATA_DIR="$PWD"
export VLA_CONFIG_YAML=libero_simulation.yaml
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl

# Optional experiment tracking
export WANDB_ENTITY=your_entity
export WANDB_PROJECT=phase-route-vla

# GPU_INDEX is used by the single-GPU launcher and must be 0, 1, 2, or 3.
export GPU_INDEX=0
