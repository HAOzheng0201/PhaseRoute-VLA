    "development_only_model_selection": true,
    "candidate_grid": {
      "PCA_plus_weighted_logistic_affine": {
        "pca_rank": [16, 32, 64, 128],
        "l2": [0.0001, 0.001, 0.01, 0.1],
        "maximum_optimizer_iterations": 200
      },
      "small_regularized_MLP": {
        "architecture": "LayerNorm(199)-Linear(199,H)-GELU-Dropout-Linear(H,H/2)-GELU-Dropout-Linear(H/2,1)",
        "hidden_width": [64, 128],
        "dropout": [0.0, 0.1],
        "weight_decay": [0.0001, 0.001],
        "learning_rate": [0.0003, 0.001],
        "training_seeds": [11260830, 11260831, 11260832],
        "maximum_epochs": 200,
        "early_stopping_patience": 20,
        "batching": "whole_cluster_balanced_minibatches"
      }
    },
    "required_baseline": "constant_prevalence_predictor",
    "primary_ranking_metric": "group_equal_average_precision",
    "secondary_metrics": [
      "group_equal_ROC_AUC",
      "false_safe_at_fixed_coverage",
      "per_task_coverage_and_risk"
    ],
    "minimum_grouped_OOF_ROC_AUC": 0.65,
    "minimum_grouped_OOF_average_precision_lift": 1.1,
    "maximum_grouped_OOF_false_safe_at_30_percent_coverage": 0.1,
    "if_feasibility_gate_fails": "stop_without_calibration_or_active_rollout"
  },
  "calibration": {
    "opened_after_development_model_is_frozen": true,
    "model_refit_after_opening": false,
