    "row_weighting": "equal_total_weight_per_cluster_then_equal_total_weight_per_task",
    "grouped_OOF": {
      "fold_count": 6,
      "fold_formula": "replicate_id % 6 on development replicates 0..11",
      "validation_clusters_per_fold": 20,
      "all_policy_calls_from_one_cluster_stay_in_one_fold": true
