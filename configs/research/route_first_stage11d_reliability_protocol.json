  "target_contract": {
    "full_action_distance": "mean_t(1 - cosine(action_L13[t,0:7], action_L27[t,0:7]))",
    "full_action_unsafe_threshold": 0.00390625,
    "full_action_unsafe_rule": "full_action_distance > 0.00390625",
    "gripper_step_unsafe_rule": "any_t((action_L13[t,6] >= 0) XOR (action_L27[t,6] >= 0))",
    "joint_unsafe_rule": "full_action_unsafe OR gripper_step_unsafe",
    "safe13_rule": "NOT joint_unsafe",
    "severe_full_action_ratio": 4.0,
    "label_source_is_runtime_input": false,
    "task_or_outcome_identity_is_label": false
  },
  "model_development": {
